#!/bin/sh
# Bloqueia commits com segredos (TruffleHog). Ativar uma vez por clone:
#   git config core.hooksPath .githooks
set -e

if ! command -v trufflehog >/dev/null 2>&1; then
    echo "pre-commit: trufflehog não encontrado no PATH; instale (https://github.com/trufflesecurity/trufflehog#installation)." >&2
    exit 1
fi

# TRUFFLEHOG_PRE_COMMIT=1 aplica os defaults de pre-commit do próprio TruffleHog
# (staged changes desde HEAD, --results=verified,unknown, --fail).
export TRUFFLEHOG_PRE_COMMIT=1
exec trufflehog git file://.
